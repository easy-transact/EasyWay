# Production (docker-compose web/celery_worker/celery_beat, or any real
# deployment): DJANGO_SECRET_KEY must be a real random value (never the
# default fallback baked into settings.py), DEBUG must be False, and
# DJANGO_ALLOWED_HOSTS must list the real domain(s) -- DEBUG=False also turns
# on SECURE_SSL_REDIRECT/HSTS/secure cookies automatically (see settings.py),
# which assumes a reverse proxy terminating TLS and forwarding
# X-Forwarded-Proto: https.
#
# Interim phase (port exposed directly, no domain/TLS reverse-proxy yet):
# set all three to False, or SECURE_SSL_REDIRECT alone would redirect every
# request to an HTTPS that doesn't exist, making the app unreachable. Flip
# back to True (or just remove the overrides -- True is the default) once a
# reverse proxy terminates TLS in front of this app.
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
#
# Note: DATABASE_URL/REDIS_URL/VALHALLA_URL/NOMINATIM_URL/PHOTON_URL/
# CELERY_*/TELEMETRIE_REDIS_URL below target localhost -- correct only when
# Django runs on the host reaching into docker-compose via published ports.
# The web/celery_worker/celery_beat services in docker-compose.yml override
# these to the in-network service names (db/redis/valhalla/...) themselves;
# you don't need to edit them for that path, only if running manage.py
# directly on the host.
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Uncomment when sharing via ngrok (leading dot matches any subdomain, so a
# free-tier random URL still works without editing this on every restart):
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
# CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app

# postgis://USER:PASSWORD@HOST:PORT/NAME -- for docker-compose.prod.yml
# specifically, POSTGRES_PASSWORD below is the single source of truth (it
# fills both the `db` service's own password and this URL's password via
# Compose variable interpolation); DATABASE_URL itself is fully overridden
# by that file's `web`/`celery_*` services and not read verbatim from here.
DATABASE_URL=postgis://easyway:easyway@localhost:5432/easyway
# Real random value in production -- docker-compose.prod.yml only.
POSTGRES_PASSWORD=change-me

# MailDev (docker-compose service `maildev`) : SMTP catcher, no auth/TLS.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Easy Way <no-reply@easyway.local>

# Deep link / page used to build verification & reset-password links in emails.
FRONTEND_URL=http://localhost:8000

# Defaults to http://localhost:5173 when DEBUG=True, empty (blocks every
# browser origin) when DEBUG=False -- must be set explicitly in production to
# whatever web frontend origin(s) actually call this API. Comma-separated,
# no wildcards. Native mobile apps aren't affected (CORS is a browser-only
# mechanism), only a web frontend needs this.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# OAuth client ID configured in Google Cloud Console for the mobile app.
GOOGLE_OAUTH_CLIENT_ID=
# Unused by the current ID-token verification flow; kept for a possible
# future server-side auth-code flow.
GOOGLE_OAUTH_CLIENT_SECRET=

# docker-compose services `redis`, `valhalla`, `nominatim` and `photon`.
REDIS_URL=redis://localhost:6379/1
VALHALLA_URL=http://localhost:8002
NOMINATIM_URL=http://localhost:8003
PHOTON_URL=http://localhost:2322

# Celery (community/tasks.py) : DB Redis /2, distincte du cache (/1).
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# P5 : flux Streams des positions GPS brutes (trips/services/producteur_evenements.py).
TELEMETRIE_REDIS_URL=redis://localhost:6379/3
